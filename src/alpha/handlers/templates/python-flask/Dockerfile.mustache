ARG BASE_IMAGE=python:3.13

FROM ${BASE_IMAGE}

ARG PIP_INDEX_URL
ARG PIP_EXTRA_INDEX_URL
ARG PIP_RETRIES
ARG PIP_ROOT_USER_ACTION=ignore
ARG UID=1000
ARG GID=1000

USER root
RUN mkdir -p /usr/src/app && chown -R root:root /usr/src/app

WORKDIR /usr/src/app

COPY --chown=${UID}:${GID} . .

RUN pip install --no-cache-dir *.whl
RUN pip install --no-cache-dir -r requirements.txt

ENV HOME=/home/app
RUN mkdir -p "${HOME}" && chown ${UID}:${GID} "${HOME}"

USER ${UID}:${GID}

EXPOSE {{serverPort}}

ENV FLASK_ENV=production

CMD ["gunicorn", "--bind", ":{{serverPort}}", "--workers", "4", "--logger-class", "alpha.utils.logging_configurator.GunicornLogger", "{{packageName}}.__main__:app"]
